mayores = 0
menores = 0
iguales = 0

while True:
    numero = int(input("Ingresa un número (999 para terminar): "))

    if numero == 999:
        break

    if numero > 0:
        mayores += 1
    elif numero < 0:
        menores += 1
    else:
        iguales += 1

print("Mayores:", mayores)
print("Menores:", menores)
print("Iguales a cero:", iguales)
